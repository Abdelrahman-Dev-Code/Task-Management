APP_NAME="Task Management API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Database (Laravel 13 - SQLite by default, or MySQL/PostgreSQL)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=task_management
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Mail / OTP Delivery (use 'log' locally to inspect OTP in storage/logs or dev_otp, or 'smtp' in production)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@taskmanagement.local"
MAIL_FROM_NAME="${APP_NAME}"

# OTP Security
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_SECRET=

# Google Sign-In / OAuth2 (for Continue with Google in Flutter & Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_CLIENT_IDS=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Sanctum & CORS
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=*

# Optional Node.js Preview Mirror (used inside AI Studio preview runtime on port 3000)
PORT=3000
NODE_ENV=development
RESEND_API_KEY=